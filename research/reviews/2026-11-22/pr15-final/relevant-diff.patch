     if [[ -x "${candidate}" ]]; then
-        resolved_bwrap="$(realpath -e -- "${candidate}" 2>/dev/null || true)"
+        resolved_bwrap="$(resolve_existing_file "${candidate}" 2>/dev/null || true)"
