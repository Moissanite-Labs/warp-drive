     if [[ ! -r "${SECCOMP_BPF}" || ! -f "${SECCOMP_BPF}" ]]; then
         echo "ERR_SANDBOX_SECCOMP: compiled seccomp BPF filter missing or unreadable: ${SECCOMP_BPF}" >&2
         exit 126
     fi
